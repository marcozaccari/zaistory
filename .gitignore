player/node_modules
player/dist
player/dist-node
assets-studio/.profile

# Uscite degli strumenti che non appartengono a nessuna storia: la sonda sui
# modelli, i confronti. Si rifanno lanciando di nuovo il comando.
assets-studio/out

# Banco di lavoro del generatore dentro ogni storia: manifest, immagini
# grezze, versioni, cache. Quello che vale davvero e' gia' pubblicato in
# stories/<id>/assets/, che invece si versiona.
stories/*/_work

# Il sito composto da build-site.mjs per GitHub Pages: lo monta l'Action a
# ogni push, in locale serve solo per dare un'occhiata prima di spingere.
_site/

# Il player incorporato dentro la cartella di una storia da
# start_local_player.sh: e' un prodotto della build, si rifa' in un secondo.
stories/*/play.html

# Python: cache dei bytecode, si rigenera sola
__pycache__/
*.pyc

# impostazioni locali di Claude Code, per macchina
.claude/settings.local.json

# Cestino di servizio: il ponte verso questa macchina non puo' cancellare file,
# quindi ci sposta dentro cio' che va rimosso (e i lock di git rimasti orfani).
# Si svuota a mano.
_to_delete/
