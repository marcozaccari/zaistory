{
  "ir_version": "1.2.0",
  "id": "storia-rotta",
  "title": "Storia deliberatamente rotta (fixture)",
  "description": "Fixture per i test del linter: contiene un esemplare di ogni bug di giocabilita' che il player CLI deve saper trovare.",
  "start_scene": "inizio",
  "scenes": [
    {
      "id": "inizio",
      "title": "Scena con ogni difetto",
      "background": { "image_prompt": "una stanza qualunque" },
      "dialogue_tree": {
        "start": "d_start",
        "nodes": {
          "d_start": {
            "speaker": "voce",
            "text": "Un nodo con una scelta che punta nel vuoto.",
            "choices": [{ "text": "Vai", "goto": "d_inesistente" }]
          },
          "d_monco": {
            "speaker": "voce",
            "text": "Nessuna scelta, nessun next, nessun end."
          }
        }
      },
      "actions": [
        {
          "id": "porta_rotta",
          "label": "Attraversa la porta che non porta da nessuna parte",
          "effect": { "goto_scene": "scena_inesistente" }
        },
        {
          "id": "porta_chiusa",
          "label": "Apri la porta con la chiave che non esiste",
          "condition": { "has_item": "chiave_mai_data" },
          "effect": { "goto_scene": "orfana" }
        },
        {
          "id": "condizione_impossibile",
          "label": "Azione che nessuno vedra' mai",
          "condition": { "flag_present": "flag_mai_impostato" },
          "effect": { "narration": "niente" }
        }
      ]
    },
    {
      "id": "orfana",
      "title": "Scena raggiungibile solo da una condizione impossibile",
      "background": { "image_prompt": "un corridoio" },
      "actions": [
        { "id": "torna", "label": "Torna indietro", "effect": { "goto_scene": "inizio" } }
      ]
    }
  ]
}
